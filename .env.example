# SoundCloud OAuth (local only — never commit real secrets)
# Register an app: https://soundcloud.com/you/apps (or SoundCloud developers portal)
# Redirect URI must match exactly (including port).

SOUNDCLOUD_CLIENT_ID=

# Client secret — usually required today.
# SoundCloud still treats most apps as confidential, so token exchange returns
# invalid_client without a secret. Put your app secret here (machine-local only).
# Leave unset only if SoundCloud has marked your app as a public PKCE client.
SOUNDCLOUD_CLIENT_SECRET=

SOUNDCLOUD_REDIRECT_URI=http://localhost:5173/auth/soundcloud/callback
